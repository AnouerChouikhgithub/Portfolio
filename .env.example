# EmailJS credentials for the /api/contact Netlify Function.
# Copy this file to .env and fill in real values (never commit .env).
# For local testing with `netlify dev`, also add these in Netlify UI → Site settings → Environment variables.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
